        <mxCell id="qKJtm4_c4aTnnIV1gB7i-23" value="Отправляет запросы для&amp;nbsp;&lt;div&gt;работы шлакбаума.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Отправляет данные&amp;nbsp;&lt;/div&gt;&lt;div&gt;для настройки&amp;nbsp;&lt;/div&gt;&lt;div&gt;автоматического&amp;nbsp;&lt;/div&gt;&lt;div&gt;доступа&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="qKJtm4_c4aTnnIV1gB7i-21">
